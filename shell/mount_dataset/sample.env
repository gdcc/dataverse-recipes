# Configuration for mount_dataset.sh. Copy this file to .env and fill in
# the real values, or set the same variables inline on the command line.

# ---- Required ----

# Dataverse base URL.
DV_URL=https://demo.dataverse.org

# Dataset persistent ID (with protocol prefix).
DV_PID=doi:10.5072/FK2/XXXXX

# S3 endpoint URL used to read the dataset's storage.
S3_ENDPOINT=https://s3.example.com

# S3 access key with read access to the storage bucket.
S3_ACCESS_KEY=

# S3 secret access key.
S3_SECRET_KEY=

# ---- Optional ----

# Dataverse API key. Leave empty for public-dataset access only; provide
# a key to reach anything that key can read (drafts, restricted, etc.).
DV_TOKEN=

# Dataset version (default :latest). Also valid: :draft, :latest-published, 1.0
DV_VERSION=:latest

# S3 bucket name (default: dataverse).
S3_BUCKET=dataverse

# 1 = path-style S3 addressing (default), 0 = virtual-host style.
USE_PATH_STYLE=1

# Host path to mount the dataset into (default: ./mount-<identifier>).
MOUNT_POINT=
